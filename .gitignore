node_modules/
dist/
*.tsbuildinfo
.DS_Store

# 出題データとジングル SE は各自ローカルに配置する（リポジトリには含めない）。
# PoC とオンライン版で共有するため、リポジトリルートに置いている。
sound/*
quiz_data/*

# ただしデータ形式のサンプルとして 1 問だけ追跡する。
# 除外したディレクトリの中身は再包含できないため、
# 20260820/ をいったん戻してから中身を除外し直している。
!quiz_data/questions_example.csv
!quiz_data/20260820/
quiz_data/20260820/*
!quiz_data/20260820/0-20260820.lab
!quiz_data/20260820/0-20260820.txt
!quiz_data/20260820/0-20260820.wav

# 上記データから生成されるため追跡しない
quiz_data/manifest.json

# API キー。.env.example をコピーして各自で用意する
server/.env

# llm-poc の実験結果。手元で貯まるものでリポジトリには含めない
llm-poc/logs/

# 確定曲線の計測結果。API を叩いて貯まるものでリポジトリには含めない
server/logs/

# 外部モデルのレビュー結果。手元で貯まるものでリポジトリには含めない
# （.cursor/rules/ は追跡対象なので .cursor/ ごとは無視しない）
.cursor/reviews/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# 設計時の資料
*.pdf
