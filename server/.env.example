# LLM 予測機能の設定。
# このファイルを .env にコピーし、使うプロバイダのキーだけ埋める。
# キーが未設定のプロバイダは /api/llm/health で available: false になり、
# PoC のセレクトボックスに現れない。

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# 早押し判定の設定。
# 使う provider（typesafe / openai / gemini）。未設定・空なら typesafe。
# 不明な値は typesafe に戻さず、health が available: false を返す。
JUDGE_PROVIDER=

# 各 provider の API キー。未設定の provider は health で available: false。
TYPESAFE_API_KEY=
# OPENAI_API_KEY / GEMINI_API_KEY は上の LLM 用と同じ変数を共用する。

# JUDGE_PROVIDER で選んだ provider だけに効くモデル上書き。
# 未設定、または他 provider では各社の既定（jev-latest / gpt-6-luna /
# gemini-decision-1）を使う。
JUDGE_MODEL=

# オンライン版で、読み切り後に AI が回答へ踏み切るまでの待ち時間（ミリ秒）。
# 読み切っても早押しは締め切られないため、人間が考える間を残す。
# 0 なら読み切りと同時に押す。
AI_READING_ENDED_DELAY_MS=5000

# 読み切り（timeUp）の応答で、JSON ではない平文を答えとして許容する最大文字数。
# これを超える平文は説明文とみなし、応答フォーマット違反として扱う。
LLM_PLAIN_ANSWER_MAX_LENGTH=30

# 音声なし問題（wav/txt/lab を用意していない問題）の文字送り間隔。
# ミリ秒/文字。句読点でのウェイトは入れず等速で送る。
QUIZ_CHAR_INTERVAL_MS=120
