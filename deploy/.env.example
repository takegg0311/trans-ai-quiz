# deploy/.env にコピーして値を埋める。deploy/.env は Git に含めない。

GCP_PROJECT=
GCP_REGION=asia-northeast1
CLOUD_RUN_SERVICE=trans-ai-quiz

# Artifact Registry のイメージ URI。未設定時は下記の規則で組み立てる。
# ${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT}/cloud-run-source-deploy/${CLOUD_RUN_SERVICE}:${IMAGE_TAG}
CONTAINER_IMAGE=
IMAGE_TAG=latest

# 通常は ${CLOUD_RUN_SERVICE}@${GCP_PROJECT}.iam.gserviceaccount.com
RUN_SERVICE_ACCOUNT=

# 初回デプロイ後に Cloud Run の URL を入れる（末尾スラッシュなし）
QUIZ_PUBLIC_URL=

# 通常は ${GCP_PROJECT}-${CLOUD_RUN_SERVICE}
QUIZ_BUCKET=

QUIZ_DATABASE=trans-ai-quiz
QUIZ_COLLECTION=quiz
